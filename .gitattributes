* text=auto eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.asset text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.prefab text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.unity text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.mat text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.blend binary
*.fbx binary
*.png binary
*.jpg binary
*.exr binary
*.ttf binary

# Unity serializes empty YAML fields with trailing spaces.
*.lighting text whitespace=-blank-at-eol,-blank-at-eof
*.giparams text whitespace=-blank-at-eol,-blank-at-eof

# Preserve the upstream formatting of bundled TextMesh Pro resources.
"Assets/TextMesh Pro/**" -whitespace
